{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "host",
            "displayName": "host",
            "description": "The unit tests, built with the host C compiler",
            "binaryDir": "${sourceDir}/../build/tests",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host",
            "displayName": "host",
            "configurePreset": "host",
            "targets": ["all"]
        }
    ],
    "testPresets": [
        {
            "name": "host",
            "displayName": "host",
            "configurePreset": "host",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
