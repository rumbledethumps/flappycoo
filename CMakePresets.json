{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "description": "cc65, with debug information",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/cc65/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CC65_TARGET_SYSTEM": "rp6502"
            }
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "description": "cc65, optimized",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/cc65/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CC65_TARGET_SYSTEM": "rp6502"
            }
        },
        {
            "name": "llvm-mos/Debug",
            "displayName": "llvm-mos/Debug",
            "description": "llvm-mos, with debug information",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/llvm-mos/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "LLVM_MOS_PLATFORM": "rp6502"
            }
        },
        {
            "name": "llvm-mos/Release",
            "displayName": "llvm-mos/Release",
            "description": "llvm-mos, optimized for size",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/llvm-mos/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS_RELEASE": "-Oz -DNDEBUG",
                "LLVM_MOS_PLATFORM": "rp6502"
            }
        },
        {
            "name": "host",
            "displayName": "host",
            "description": "The unit tests, built with the host C compiler",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/host",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "HOST_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "configurePreset": "cc65/Debug",
            "targets": ["all"]
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "configurePreset": "cc65/Release",
            "targets": ["all"]
        },
        {
            "name": "llvm-mos/Debug",
            "displayName": "llvm-mos/Debug",
            "configurePreset": "llvm-mos/Debug",
            "targets": ["all"]
        },
        {
            "name": "llvm-mos/Release",
            "displayName": "llvm-mos/Release",
            "configurePreset": "llvm-mos/Release",
            "targets": ["all"]
        },
        {
            "name": "host",
            "displayName": "host",
            "configurePreset": "host",
            "targets": ["all"]
        }
    ],
    "testPresets": [
        {
            "name": "host",
            "displayName": "host",
            "configurePreset": "host",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "cc65/Debug",
            "displayName": "cc65/Debug",
            "configurePreset": "cc65/Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "cc65/Release",
            "displayName": "cc65/Release",
            "configurePreset": "cc65/Release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "llvm-mos/Debug",
            "displayName": "llvm-mos/Debug",
            "configurePreset": "llvm-mos/Debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "llvm-mos/Release",
            "displayName": "llvm-mos/Release",
            "configurePreset": "llvm-mos/Release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
